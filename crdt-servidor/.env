# Cada instalación representa un nodo.
NODE_ID=B
NODE_NAME=Nodo Servidor

# URL pública o accesible del otro nodo, sin barra final.
# Ejemplo para el nodo local apuntando al servidor:
PEERS=http://gustavo-ntb:8000

# Debe ser exactamente el mismo valor en todos los nodos.
PEER_TOKEN=ComodoroSD2026

# Texto inicial determinista. Debe coincidir en todos los nodos nuevos.
SEED_TEXT=hola mundo!

# Puerto publicado en esta máquina.
HOST_PORT=8080
